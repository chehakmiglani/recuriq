# Copy this file to ".env" (same folder) and fill in what you need.
# .env is git-ignored, so your keys are never uploaded.
# The backend reads it on start-up, and so does "docker compose up".

# AI analyst: a free Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Or use Claude instead (used only when GROQ_API_KEY is empty)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Database (defaults shown)
# DB_URL=jdbc:mysql://localhost:3306/subscription_billing
# DB_USERNAME=root
# DB_PASSWORD=root
